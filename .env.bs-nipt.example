# Copy to <project-root>/env/bs10610.env, fill secrets, and chmod 600.
COMPOSE_PROJECT_NAME=airflow-bs-control
BS_HOST_IP=172.17.106.10
PLATFORM_ENVIRONMENT=BS10610
AIRFLOW_DEMO_TZ=Asia/Shanghai
# Keep the image-owned airflow account. Grant this UID access to shared/ with ACL.
AIRFLOW_UID=50000
DOCKER_SOCKET_GID=<BS_DOCKER_GID>

AIRFLOW_IMAGE=airflow-demo/airflow:bs-control-<GIT_SHA>
BACKEND_IMAGE=airflow-demo/backend:bs-control-<GIT_SHA>
FRONTEND_IMAGE=airflow-demo/frontend:bs-control-<GIT_SHA>

FRONTEND_PORT=12959
AIRFLOW_PORT=12958
PUBLIC_AIRFLOW_URL=http://172.17.106.10:12958

POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=airflow
BIODEMO_DB=biodemo
BIODEMO_USER=biodemo
BIODEMO_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql+psycopg://biodemo:<CHANGE_ME>@postgres:5432/biodemo

AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=<CHANGE_ME>
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME>
AIRFLOW_WEBSERVER_SECRET_KEY=<CHANGE_ME>
INTERNAL_SERVICE_TOKEN=<CHANGE_ME>

PROJECT_ROOT=/mnt/biodevrwbi/33.chenjiucheng/project/airflow-NIPT
HOST_SHARED_ROOT=/mnt/biodevrwbi/33.chenjiucheng/airflow-result/nipt
NIPT_REQUEST_HOST_ROOT=/mnt/biodevrwbi/33.chenjiucheng/airflow-intake-configs/nipt
NIPT_FASTQ_HOST_ROOT=/sugon01/fq_backup/NIPT_fq_backup
NIPT_WORKFLOW_HOST_ROOT=/mnt/biodevrwsg2/33.chenjiucheng/mapper_v2_test/nipt_workflow
NIPT_LOCALE_HOST_ROOT=/sg2/33.chenjiucheng/project/back_up/NIPTpro/pipeline/src/locale
NIPT_DOCKER_OWNER=6708:520

# The same Airflow control plane submits WGS stages through restricted SSH.
WGS_PROJECT_ROOT=/mnt/biodevrwbi/33.chenjiucheng/project/airflow-WGS
WGS_RESULTS_HOST_ROOT=/mnt/biodevrwbi/33.chenjiucheng/airflow-result/wgs
WGS_INTAKE_HOST_ROOT=/mnt/biodevrwbi/33.chenjiucheng/airflow-intake-configs/wgs
WGS_VALIDATION_HOST_ROOT=/mnt/biodevrwsg2/33.chenjiucheng/WGS_test/WGS_20260527_T7Hg38V3.8.0_JX25_full_batchaware_direct_20260709_20260709_015245
WGS_SSH_HOST=172.17.106.10
WGS_SSH_LOGIN=chenjc
WGS_HOST_OWNER=6708:520
WGS_SSH_KEY_GID=520
WGS_SSH_KEY_PATH=/mnt/biodevrwbi/33.chenjiucheng/project/airflow-WGS/shared/ssh/id_ed25519
WGS_SSH_KNOWN_HOSTS_PATH=/mnt/biodevrwbi/33.chenjiucheng/project/airflow-WGS/shared/ssh/known_hosts
