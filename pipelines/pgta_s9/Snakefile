REF_TARGET_FILES = []
if BUILD_REF_BY_SEX_ENABLED:
    REF_TARGET_FILES = [REF_OUTPUTS_BY_SEX[sex] for sex in ("XX", "XY")] + [GENDER_REF_OUTPUT, COMMON_REF_BINSIZE]
elif REF_OUTPUT:
