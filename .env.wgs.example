# Copy to a local .env.wgs file; do not commit credentials or private OBS configuration.
COMPOSE_PROJECT_NAME=airflow-wgs
AIRFLOW_IMAGE=airflow-demo/airflow:0.1.0
BACKEND_IMAGE=airflow-demo/backend:0.1.0
FRONTEND_IMAGE=airflow-demo/frontend:0.1.0
AIRFLOW_UID=50000
AIRFLOW_PORT=12958
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
POSTGRES_DB=airflow
BIODEMO_DB=biodemo
BIODEMO_USER=biodemo
BIODEMO_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
DATABASE_URL=postgresql+psycopg://biodemo:<MATCH_BIODEMO_PASSWORD>@postgres:5432/biodemo
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
AIRFLOW_ADMIN_EMAIL=airflow-demo@example.com
INTERNAL_SERVICE_TOKEN=<CHANGE_ME_LOCAL_ONLY>
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
BS_HOST_IP=172.17.106.10
FRONTEND_PORT=12959
BACKEND_BASE_URL=http://backend:8000
WGS_EXECUTION_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
WGS_INTAKE_HOST_ROOT=<CONTROLLED_WGS_INTAKE_ROOT>
WGS_RESULTS_HOST_ROOT=<CONTROLLED_WGS_RESULTS_ROOT>
WGS_EVIDENCE_HOST_ROOT=<CCE_EVIDENCE_ROOT_ON_BS10610>
