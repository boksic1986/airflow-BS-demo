# Copy to a local .env.wgs file; do not commit credentials or private OBS configuration.
COMPOSE_PROJECT_NAME=airflow-wgs
PLATFORM_ENVIRONMENT=Demo
AIRFLOW_IMAGE=airflow-demo/airflow:0.1.0
BACKEND_IMAGE=airflow-demo/backend:0.1.0
FRONTEND_IMAGE=airflow-demo/frontend:0.1.0
AIRFLOW_UID=50000
AIRFLOW_PORT=12958
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
POSTGRES_DB=airflow
BIODEMO_DB=biodemo
BIODEMO_USER=biodemo
BIODEMO_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
DATABASE_URL=postgresql+psycopg://biodemo:<MATCH_BIODEMO_PASSWORD>@postgres:5432/biodemo
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
AIRFLOW_ADMIN_EMAIL=airflow-demo@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=<CHANGE_ME_LOCAL_ONLY>
INTERNAL_SERVICE_TOKEN=<CHANGE_ME_LOCAL_ONLY>
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=<CHANGE_ME_LOCAL_ONLY>
BS_HOST_IP=172.17.106.10
FRONTEND_PORT=12959
BACKEND_BASE_URL=http://backend:8000
WGS_EXECUTION_ENABLED=false
WGS_RUNTIME_ADAPTER_ENABLED=false
WGS_INTAKE_SCAN_ENABLED=true
WGS_INTAKE_SCAN_INTERVAL_SECONDS=600
WGS_AUTO_DISPATCH_ENABLED=false
# Required safety watermark when auto dispatch is enabled. Existing ready rows
# before this instant remain a non-dispatching baseline.
WGS_AUTO_DISPATCH_NOT_BEFORE=
WGS_INTAKE_IGNORED_CHIP_IDS=
WGS_T7_FASTQ_HOST_ROOT=/bi/fastq/T7_Fastq
WGS_RUNTIME_HOST_ROOT=/mnt/biodevrwsg2/33.chenjiucheng/WGS_test/airflow-wgs/runtime
WGS_RUNTIME_BS_ROOT=/mnt/biodevrwsg2/33.chenjiucheng/WGS_test/airflow-wgs/runtime
WGS_RUNTIME_NODE200_ROOT=/sg2/biodevrwsg2/33.chenjiucheng/WGS_test/airflow-wgs/runtime
WGS_RUNTIME_SHARED_GID=520
WGS_SSH_KEY_HOST_ROOT=/home/chenjc/.config/airflow-wgs/ssh-node200
WGS_RUNNER_200_HOST=172.17.61.200
WGS_RUNNER_200_LOGIN=chenjc
WGS_RUNNER_200_ALIAS=wgs-node200
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
WGS_INTAKE_HOST_ROOT=<CONTROLLED_WGS_INTAKE_ROOT>
WGS_INTAKE_NODE200_ROOT=<SAME_CONTROLLED_WGS_INTAKE_ROOT_ON_NODE200>
WGS_FASTQ_HOST_ROOT=<CONTROLLED_FASTQ_TARGET_ROOT>
WGS_RESULTS_HOST_ROOT=<CONTROLLED_WGS_RESULTS_ROOT>
WGS_EVIDENCE_HOST_ROOT=<CCE_EVIDENCE_ROOT_ON_BS10610>
WGS_BINDING_HOST_ROOT=<PLATFORM_OWNED_BINDING_ROOT_ON_BS10610>
