WGS_EXECUTION_ENABLED=false
WGS_RUNTIME_ADAPTER_ENABLED=false
WGS_STEP3_DRYRUN_CANARY_ENABLED=false
WGS_NODE97_FULL_CANARY_ENABLED=false
WGS_RUNTIME_REQUEST_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/runner-requests
WGS_RUNTIME_RUN_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/runs
WGS_ANALYSIS_PROJECT_NODE200_ROOT=/sg2/50.ctapa/project/HWcloud/WGS_Clinical
# The current and historical production worktrees are allowlisted by release ID.
WGS_REPO_ROOT=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.2.0
WGS_RELEASE_ROOTS_JSON={"wgs-4.2.0-b067c72":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.2.0","wgs-4.1.1-6c98281":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1","wgs-4.1.1-2499749":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1","wgs-4.1.1-cdee32c":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1","wgs-4.1.1-1656b5d":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1","wgs-4.1.1-1778fca":"/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1"}
WGS_PYTHON=/sg2/33.chenjiucheng/software/miniforge3/envs/nipttest/bin/python
# Optional immutable/operator config outside the protected WGS source worktree.
# Both values must point to the same approved configuration directory.
WGS_PREPARE_CONFIG=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.2.0/prepare/config.yaml
WGS_PREPARE_CONFIG_ROOT=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.2.0/prepare
CCE_OPERATOR_CONFIG=/home/ctapa/.config/wgs/cce.yaml
WGS_CCE_PROFILE_ROOT=/bi/biodevrwbi/33.chenjiucheng/project/cce-pipeline-profiles/wgs
# WGS 4.2.0 is pinned to the validated cce-pipeline 0.8.3 executable.
CCE_PIPELINE_BIN=/sg2/33.chenjiucheng/software/miniforge3/envs/nipttest/bin/cce-pipeline
WGS_TRANSFER_ADAPTER=obsutil
# cce-pipeline 0.8.3 keeps these file-level transfer limits independent from
# the Kubernetes heavy work-pod quota. The values live in the private
# cce.yaml operator config and are frozen into RESOLVED_PROFILE.yaml.
WGS_TRANSFER_SPOOL_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/transfer-progress
WGS_CCE_EVIDENCE_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/cce-evidence
WGS_REAL_OBSUTIL_BIN=/bi/software/obsutil_5.8.3/obsutil
WGS_MONITOR_INTERVAL_SECONDS=5
WGS_MONITOR_TIMEOUT_SECONDS=432000
WGS_STEP4_MASTER_COMPLETION_GRACE_SECONDS=600
PATH=/bi/software/mamba/envs/WGS/bin:/usr/local/bin:/usr/bin:/bin
