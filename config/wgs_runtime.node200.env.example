WGS_EXECUTION_ENABLED=false
WGS_RUNTIME_ADAPTER_ENABLED=false
WGS_STEP3_DRYRUN_CANARY_ENABLED=false
WGS_NODE97_FULL_CANARY_ENABLED=false
WGS_RUNTIME_REQUEST_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/runner-requests
WGS_RUNTIME_RUN_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/runs
# The production worktree is readable by ctapa and clean at the catalog commit.
# Do not switch this to wgs-4.1.1-test: that copy fails the tracked-drift gate.
WGS_REPO_ROOT=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1
WGS_PYTHON=/bi/software/mamba/envs/WGS/bin/python
# Optional immutable/operator config outside the protected WGS source worktree.
# Both values must point to the same approved configuration directory.
WGS_PREPARE_CONFIG=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1/prepare/config.yaml
WGS_PREPARE_CONFIG_ROOT=/bi/biodevrwbi/33.chenjiucheng/project/wgs-4.1.1/prepare
CCE_OPERATOR_CONFIG=/home/ctapa/.config/wgs/cce.yaml
# Optional validated 0.8.x CLI override for an isolated test runtime. Leave empty
# in production to use the WGS repository's approved default executable.
CCE_PIPELINE_BIN=
WGS_TRANSFER_ADAPTER=obs_sdk
# cce-pipeline 0.8.3 keeps these file-level transfer limits independent from
# the Kubernetes heavy work-pod quota. The values live in the private
# cce.yaml operator config and are frozen into RESOLVED_PROFILE.yaml.
WGS_TRANSFER_SPOOL_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/transfer-progress
WGS_CCE_EVIDENCE_ROOT=/sg2/50.ctapa/project/HWcloud/ngs-huaweicloud/runtime/cce-evidence
WGS_REAL_OBSUTIL_BIN=/bi/software/obsutil_5.8.3/obsutil
WGS_GIT_MNT_PREFIX=/mnt/biodevrwbi
WGS_GIT_NODE_PREFIX=/bi/biodevrwbi
WGS_MONITOR_INTERVAL_SECONDS=5
WGS_MONITOR_TIMEOUT_SECONDS=432000
WGS_STEP4_MASTER_COMPLETION_GRACE_SECONDS=600
PATH=/bi/software/mamba/envs/WGS/bin:/usr/local/bin:/usr/bin:/bin
